rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────────────

    // Usuario autenticado
    function isAuth() {
      return request.auth != null;
    }

    // Lee el doc del usuario desde /users/{uid}
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Rol del usuario
    function userRole() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? userData().role : null;
    }

    // EmpresaId ACTIVO del usuario (la empresa en la que está trabajando ahora)
    function userEmpresaId() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? userData().empresaId : null;
    }

    // ── MULTIEMPRESA ─────────────────────────────────────
    // Lista de empresas a las que el usuario pertenece. Es la fuente de
    // verdad de la membresía y SOLO un admin puede modificarla (ver la
    // regla de /users/{uid} más abajo).
    //
    // El fallback a [empresaId] mantiene funcionando a los usuarios que
    // todavía no han pasado por la migración: siguen viendo su empresa
    // de siempre y nada se rompe.
    function misEmpresas() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userData().get('empresasIds', userEmpresaId() != null ? [userEmpresaId()] : [])
        : [];
    }

    // ¿El usuario es miembro de esta empresa? (activa o no)
    function esMiembroDe(empresaId) {
      return isAuth() && (userEmpresaId() == empresaId || empresaId in misEmpresas());
    }

    // Superadmin global — acceso total a todo
    function isSuperAdmin() {
      return isAuth() && userRole() == 'superadmin';
    }

    // Admin de contrato — acceso total dentro de su empresa
    function isAdminContrato() {
      return isAuth() && userRole() == 'admin_contrato';
    }

    // Mandante admin — puede gestionar usuarios mandante de su empresa
    function isMandanteAdmin() {
      return isAuth() && userRole() == 'mandante_admin';
    }

    // Cualquier admin (superadmin o admin_contrato)
    function isAnyAdmin() {
      return isSuperAdmin() || isAdminContrato();
    }

    // Usuario pertenece a esta empresa.
    // Antes solo comparaba contra la empresa activa; ahora acepta cualquiera
    // de sus membresías, porque al cambiar de empresa hay un instante en que
    // el cliente ya pide datos de la nueva mientras el doc de usuario aún
    // viaja. La separación de datos la hace la interfaz mostrando una sola
    // empresa a la vez; las reglas solo verifican que tenga derecho a ambas.
    function belongsToEmpresa(empresaId) {
      return esMiembroDe(empresaId);
    }

    // Usuario tiene acceso de lectura/escritura a la empresa
    // (cualquier rol excepto trabajador y mandante pueden operar)
    // Un usuario finiquitado o desactivado (users.estado distinto de 'activo')
    // conserva su cuenta pero ya no escribe: el finiquito corta el acceso.
    // Una sola lectura de la ficha (ver la nota de PERMISOS POR ÁREA).
    function canWriteEmpresa(empresaId) {
      let u = fichaUsuario();
      let rol = u.get('role', '');
      let eid = u.get('empresaId', null);
      return isAuth()
          && (eid == empresaId || empresaId in u.get('empresasIds', eid != null ? [eid] : []))
          && rol != 'trabajador'
          && rol != 'mandante'
          && u.get('estado', 'activo') == 'activo';
    }

    // Trabajador autenticado con cuenta @mpf.cl (u otro dominio de empresa)
    function isTrabajador() {
      return isAuth()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userRole() == 'trabajador'
          && userData().get('estado', 'activo') == 'activo';
    }

    // Mandante — solo lectura
    function isMandante() {
      return isAuth() && userRole() == 'mandante';
    }

    // Jefe de taller — módulo Maquinaria
    function isJefeTaller() {
      return isAuth() && userRole() == 'jefe_taller';
    }

    // Mecánico — módulo Maquinaria
    function isMecanico() {
      return isAuth() && userRole() == 'mecanico';
    }

    // Puede gestionar el módulo Maquinaria (crear OT, planes, cerrar, stock)
    function canManageMaquinaria() {
      return isSuperAdmin() || isAdminContrato() || userRole() == 'administrativo' || isJefeTaller();
    }

    // ── PERMISOS POR ÁREA ────────────────────────────────
    // Antes cualquier rol con escritura (operador, mecánico, jefe de taller)
    // podía escribir remuneraciones, bancos, flujo y asientos con el SDK: la
    // separación era solo visual. Ahora se aplica la misma regla que el
    // selector de apps (App.jsx): admin_contrato entra a todo; administrativo
    // y operador solo a los módulos que tienen en `modulos`.
    // Una sola lectura de la ficha y cálculo directo: encadenar los helpers
    // de arriba (cada uno con su exists/get) superaba el límite de evaluación
    // del motor de reglas y la petición entera fallaba.
    function fichaUsuario() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? userData() : {};
    }
    // `modulos` es una lista; algunas fichas antiguas lo tienen como texto "a,b".
    // patron: expresión regular con los módulos aceptados, p. ej. 'rrhh|finanzas'
    function areaDe(empresaId, modulos, patron) {
      let u = fichaUsuario();
      let rol = u.get('role', '');
      let ms = u.get('modulos', []);
      let miembro = u.get('empresaId', '') == empresaId || empresaId in u.get('empresasIds', []);
      return rol == 'superadmin'
          || (miembro && u.get('estado', 'activo') == 'activo' && (rol == 'admin_contrato'
              || ((rol == 'administrativo' || rol == 'operador')
                  && ((ms is list && ms.hasAny(modulos)) || (ms is string && ms.matches('.*(' + patron + ').*'))))));
    }
    function puedeRRHH(empresaId)         { return areaDe(empresaId, ['rrhh'], 'rrhh'); }
    function puedeFinanzas(empresaId)     { return areaDe(empresaId, ['finanzas'], 'finanzas'); }
    function puedeContabilidad(empresaId) { return areaDe(empresaId, ['contabilidad'], 'contabilidad'); }
    // Lectura de sueldos: RRHH, y las áreas que los usan como costo
    // (Contabilidad, Finanzas y Oficina Técnica para mano de obra por obra).
    function leeSueldos(empresaId) {
      return areaDe(empresaId, ['rrhh', 'contabilidad', 'finanzas', 'fleetcore'], 'rrhh|contabilidad|finanzas|fleetcore');
    }
    // Lectura de finanzas: Finanzas, Contabilidad y Reportes (gerencia)
    function leeFinanzas(empresaId) {
      return areaDe(empresaId, ['finanzas', 'contabilidad', 'reportes'], 'finanzas|contabilidad|reportes');
    }
    // Personal de oficina (no terreno): admin y administrativo
    function esOficina(empresaId) {
      let u = fichaUsuario();
      return u.get('role', '') == 'superadmin'
          || ((u.get('empresaId', '') == empresaId || empresaId in u.get('empresasIds', []))
              && u.get('estado', 'activo') == 'activo'
              && u.get('role', '') in ['admin_contrato', 'administrativo']);
    }

    // ── NUEVO ────────────────────────────────────────────
    // Id de la ficha de trabajador vinculada a quien hace la petición.
    // El portal guarda el índice uid → trabajadorDocId en trabajadores_portal.
    // Se usa para que un trabajador solo pueda operar sobre lo suyo.
    function miTrabajadorDocId(empresaId) {
      return exists(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid))
        ? get(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid)).data.trabajadorDocId
        : null;
    }

    // ─────────────────────────────────────────────────────
    // COLECCIONES GLOBALES (solo superadmin)
    // ─────────────────────────────────────────────────────

    match /settings/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /subscription_intents/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    // EMPRESAS — solo superadmin puede crear/listar empresas
    //            admin_contrato puede leer su propia empresa
    // ─────────────────────────────────────────────────────

    match /empresas/{empresaId} {
      // Antes cualquier usuario autenticado leía todas las empresas (RUT,
      // adminEmail, adminUid). Ahora: sus miembros, sus sub-empresas, y quien
      // figura como admin (para vincularse en el primer ingreso).
      allow read:  if isSuperAdmin()
                   || esMiembroDe(empresaId)
                   || (isAuth() && (
                         resource.data.get('parentEmpresaId', '__ninguna__') in misEmpresas()
                         || resource.data.get('adminUid', '') == request.auth.uid
                         || resource.data.get('adminEmail', '__ninguno__') == request.auth.token.email));
      // Superadmin puede todo; usuario nuevo puede crear su primera empresa (sin empresaId aún);
      // O un administrador/usuario autorizado puede crear una sub-empresa
      allow create: if isSuperAdmin()
                    || (isAuth() && !exists(/databases/$(database)/documents/users/$(request.auth.uid)))
                    || (isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('empresaId', null) == null)
                    || (isAuth() && request.resource.data.get('parentEmpresaId', null) == userEmpresaId() && canWriteEmpresa(userEmpresaId()));
      // admin_contrato puede editar su propia empresa raíz
      // superadmin puede todo
      // canWriteEmpresa permite editar sub-empresas propias
      allow update: if isSuperAdmin()
                    || (isAdminContrato() && userEmpresaId() == empresaId)
                    || (isAuth() && resource.data.get('parentEmpresaId', null) == userEmpresaId() && canWriteEmpresa(userEmpresaId()));
      allow delete: if isSuperAdmin()
                    || (isAuth() && resource.data.get('parentEmpresaId', null) == userEmpresaId() && canWriteEmpresa(userEmpresaId()));

      // ── USUARIOS DE LA EMPRESA ──────────────────────────
      match /users/{uid} {
        allow read:  if isAuth() && (
                       request.auth.uid == uid
                       || isSuperAdmin()
                       || (userEmpresaId() == empresaId && isAnyAdmin())
                     );
        // El propio usuario solo en una empresa de la que ya es miembro (antes
        // podía crearse una ficha en la subcolección de cualquier empresa).
        allow write: if isAuth() && (
                       (request.auth.uid == uid && belongsToEmpresa(empresaId))
                       || isSuperAdmin()
                       || (isAdminContrato() && userEmpresaId() == empresaId)
                     );
      }

      // ── TRABAJADORES ────────────────────────────────────
      match /trabajadores/{trabajadorId} {
        allow read, write: if isSuperAdmin()
                           || (canWriteEmpresa(empresaId));
        // Trabajador lee su propio perfil
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && (resource == null || resource.data.portalUid == request.auth.uid);
        // Trabajador crea su propio registro al aceptar una invitación
        allow create: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && request.resource.data.portalUid == request.auth.uid;
        // …o, si RRHH ya tenía su ficha con el mismo email, la encuentra y se
        // vincula a ella (una ficha por persona). Solo puede escribir el
        // vínculo, y solo si la ficha no estaba vinculada a otra cuenta.
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && resource.data.get('email', '') == request.auth.token.email;
        allow update: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && resource.data.get('email', '') == request.auth.token.email
                    && resource.data.get('portalUid', '') in ['', null]
                    && request.resource.data.portalUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['portalUid', 'portalEmail', 'updatedAt']);
      }

      match /trabajadores_portal/{uid} {
        allow read:  if isAuth() && request.auth.uid == uid;
        allow write: if isSuperAdmin()
                     || (canWriteEmpresa(empresaId));
        // Trabajador crea su propio vínculo al aceptar una invitación, y solo
        // hacia una ficha que ya está vinculada a su cuenta (antes podía
        // apuntar a la ficha de cualquiera y leer sus liquidaciones).
        allow create: if isAuth() && request.auth.uid == uid
                    && belongsToEmpresa(empresaId)
                    && isTrabajador()
                    && exists(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores/$(request.resource.data.trabajadorDocId))
                    && get(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores/$(request.resource.data.trabajadorDocId)).data.get('portalUid', '') == request.auth.uid;
      }

      // ── CONTRATOS, ANEXOS, FINIQUITOS ───────────────────
      match /contratos/{docId} {
        allow read:  if isSuperAdmin() || leeSueldos(empresaId);
        allow write: if isSuperAdmin() || puedeRRHH(empresaId);
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && (resource == null || (resource.data.trabajadorId != null
                    && existsAfter(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid))
                    && get(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid)).data.trabajadorDocId == resource.data.trabajadorId));
      }

      match /finiquitos/{docId} {
        allow read:  if isSuperAdmin() || leeSueldos(empresaId);
        allow write: if isSuperAdmin() || puedeRRHH(empresaId);
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && (resource == null || (resource.data.trabajadorId != null
                    && get(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid)).data.trabajadorDocId == resource.data.trabajadorId));
      }

      match /anexos/{docId} {
        allow read:  if isSuperAdmin() || leeSueldos(empresaId);
        allow write: if isSuperAdmin() || puedeRRHH(empresaId);
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && (resource == null || (resource.data.trabajadorId != null
                    && get(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid)).data.trabajadorDocId == resource.data.trabajadorId));
      }

      // ── REMUNERACIONES ───────────────────────────────────
      match /remuneraciones/{docId} {
        allow read:  if isSuperAdmin() || leeSueldos(empresaId);
        allow write: if isSuperAdmin() || puedeRRHH(empresaId);
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && (resource == null || (resource.data.trabajadorId != null
                    && get(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid)).data.trabajadorDocId == resource.data.trabajadorId));
        // Acuse de recibo: el trabajador puede confirmar la recepción de SU
        // liquidación, pero SOLO puede tocar el campo acuseRecibo — nunca los
        // montos ni ningún otro dato de la remuneración.
        allow update: if isTrabajador()
                      && belongsToEmpresa(empresaId)
                      && resource.data.trabajadorId != null
                      && miTrabajadorDocId(empresaId) == resource.data.trabajadorId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acuseRecibo']);
      }

      // ── LICENCIAS MÉDICAS ────────────────────────────────
      // El trabajador lee las suyas, pero no las escribe: quien registra folio
      // y fechas es RRHH contra el documento físico. Si más adelante se quiere
      // que suba su licencia desde el portal, eso va en una colección de
      // solicitudes aparte — igual que vacaciones — y no acá.
      //
      // Los días de reposo se derivan de las fechas al leer, nunca se guardan,
      // así que no hay campo que un trabajador pudiera falsear para cambiar su
      // propia liquidación aunque tuviera escritura.
      match /licencias/{docId} {
        allow read:  if isSuperAdmin() || leeSueldos(empresaId);
        allow write: if isSuperAdmin() || puedeRRHH(empresaId);
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && (resource == null || (resource.data.trabajadorId != null
                    && miTrabajadorDocId(empresaId) == resource.data.trabajadorId));
      }

      // ── ASISTENCIA ───────────────────────────────────────
      match /asistencia/{docId} {
        allow read, write: if isSuperAdmin()
                           || canWriteEmpresa(empresaId);
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && (resource == null || resource.data.trabajadorId == request.auth.uid);
        allow create: if isTrabajador()
                      && belongsToEmpresa(empresaId)
                      && request.resource.data.trabajadorId == request.auth.uid;
        allow update: if isTrabajador()
                      && belongsToEmpresa(empresaId)
                      && resource.data.trabajadorId == request.auth.uid;
      }

      // ── TURNOS Y ASIGNACIONES ────────────────────────────
      match /turnos/{docId} {
        allow read: if belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || canWriteEmpresa(empresaId);
      }

      match /asignaciones_turnos/{docId} {
        allow read: if belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || canWriteEmpresa(empresaId);
      }

      // ── VACACIONES ───────────────────────────────────────
      // CAMBIO: antes un trabajador podía crear una solicitud a nombre de
      // cualquier otro y en cualquier estado — incluido 'aprobada', o sea,
      // autoaprobarse. Ahora la solicitud tiene que ser suya y nacer pendiente.
      // La aprobación sigue siendo exclusiva de RRHH.
      match /vacaciones/{docId} {
        allow read: if belongsToEmpresa(empresaId);

        allow create: if isSuperAdmin()
                      || canWriteEmpresa(empresaId)
                      || (isTrabajador()
                          && belongsToEmpresa(empresaId)
                          && request.resource.data.trabajadorId == miTrabajadorDocId(empresaId)
                          && request.resource.data.estado == 'pendiente');

        // El trabajador puede corregir su solicitud mientras siga pendiente,
        // sin cambiarle el dueño ni el estado.
        allow update: if isSuperAdmin()
                      || canWriteEmpresa(empresaId)
                      || (isTrabajador()
                          && belongsToEmpresa(empresaId)
                          && resource.data.trabajadorId == miTrabajadorDocId(empresaId)
                          && resource.data.estado == 'pendiente'
                          && request.resource.data.estado == 'pendiente'
                          && request.resource.data.trabajadorId == resource.data.trabajadorId);

        allow delete: if isSuperAdmin() || canWriteEmpresa(empresaId);
      }

      // ── PERMISOS ─────────────────────────────────────────
      // Mismo flujo que vacaciones: el trabajador solicita (nace pendiente y
      // suyo), puede corregir mientras siga pendiente; la resolución
      // (aprobado/rechazado) es exclusiva de RRHH.
      match /permisos/{docId} {
        allow read: if belongsToEmpresa(empresaId);

        allow create: if isSuperAdmin()
                      || canWriteEmpresa(empresaId)
                      || (isTrabajador()
                          && belongsToEmpresa(empresaId)
                          && request.resource.data.trabajadorId == miTrabajadorDocId(empresaId)
                          && request.resource.data.estado == 'pendiente');

        allow update: if isSuperAdmin()
                      || canWriteEmpresa(empresaId)
                      || (isTrabajador()
                          && belongsToEmpresa(empresaId)
                          && resource.data.trabajadorId == miTrabajadorDocId(empresaId)
                          && resource.data.estado == 'pendiente'
                          && request.resource.data.estado == 'pendiente'
                          && request.resource.data.trabajadorId == resource.data.trabajadorId);

        allow delete: if isSuperAdmin() || canWriteEmpresa(empresaId);
      }

      match /ausencias/{docId} {
        allow read: if belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || canWriteEmpresa(empresaId);
      }

      // ── REPORTES WORKFLEET (mandante puede leer) ─────────
      match /reportes_detallados/{docId} {
        allow read:  if isSuperAdmin()
                     || canWriteEmpresa(empresaId)
                     || (isMandante() && belongsToEmpresa(empresaId));
        allow write: if isSuperAdmin()
                     || canWriteEmpresa(empresaId);
      }

      match /reportes_combustible/{docId} {
        allow read:  if isSuperAdmin()
                     || canWriteEmpresa(empresaId)
                     || (isMandante() && belongsToEmpresa(empresaId));
        allow write: if isSuperAdmin()
                     || canWriteEmpresa(empresaId);
      }

      // ── RESTO DE COLECCIONES DE EMPRESA ──────────────────
      // Acceso completo para admins y roles operativos de la empresa
      match /projects/{docId}              { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /machines/{docId}              { allow read: if isSuperAdmin() || belongsToEmpresa(empresaId); allow write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /dailyLogs/{docId}             { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /fuelLogs/{docId}              { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /employees/{docId}             { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /employeeMonthlyData/{docId}   { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /employeeAssignments/{docId}   { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /purchaseOrders/{docId}        { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /rendiciones/{docId}           { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /subcontratos/{docId}          { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /estadoPagoIngresos/{docId}    { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /combustibleRegistros/{docId}      { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /combustiblePrecioMensual/{docId}  { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /actividades_disponibles/{docId} { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /bandas_salariales/{docId}     { allow read: if isSuperAdmin() || leeSueldos(empresaId); allow write: if isSuperAdmin() || puedeRRHH(empresaId); }
      // Catálogo de ítems de pago (bonos y descuentos con nombre propio).
      // Solo define nombres y clasificación: los montos viven dentro de cada
      // liquidación, que ya está protegida por su propia regla.
      match /items_pago/{docId}            { allow read: if isSuperAdmin() || leeSueldos(empresaId); allow write: if isSuperAdmin() || puedeRRHH(empresaId); }
      // Anticipos de remuneración y nóminas bancarias emitidas.
      // `nominas_pago` es el registro de lo efectivamente transferido: se crea
      // al generar el archivo y no debería editarse después.
      match /anticipos/{docId}             { allow read: if isSuperAdmin() || leeSueldos(empresaId); allow write: if isSuperAdmin() || puedeRRHH(empresaId); }
      match /nominas_pago/{docId}          { allow read: if isSuperAdmin() || leeSueldos(empresaId); allow write: if isSuperAdmin() || puedeRRHH(empresaId); }
      match /catalogo_maquinas/{docId}     { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /costos_fijos/{docId}          { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /empresas_combustible/{docId}  { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /equipos_surtidores/{docId}    { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /estaciones_combustible/{docId}{ allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /flujo_config/{docId}          { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /flujo_cuentas/{docId}         { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /flujo_pagados/{docId}         { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /flujo_notas/{docId}           { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /flujo_pagos/{docId}           { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      // Propuestas de flujo de caja: borradores que no tocan flujo_pagos hasta aprobarse
      match /flujo_propuestas/{docId}      { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      // Memoria compartida del asistente IA (notas que el equipo le pide recordar)
      // Se carga en el contexto del asistente de todos: solo la oficina la escribe
      // (un operador podía dejar instrucciones que el agente seguía para todos).
      // Contraseñas para reimprimir los QR de acceso (src/lib/credencialesQR.js).
      // Antes estaban en texto plano en trabajadores/users, legibles por operadores.
      match /credenciales_qr/{docId}       { allow read, write: if esOficina(empresaId); }
      match /agente_memoria/{docId}        { allow read: if isSuperAdmin() || canWriteEmpresa(empresaId); allow write: if esOficina(empresaId); }

      // ── BANCOS Y PROVEEDORES (Finanzas) ─────────────────
      // Estaban solo en la consola de Firebase y no en este archivo: al
      // publicarlo completo se perdían y Bancos/Proveedores dejaban de cargar.
      match /banco_cuentas/{docId}         { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /banco_movimientos/{docId}     { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /banco_importaciones/{docId}   { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /banco_reglas/{docId}          { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /proveedores/{docId}           { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }

      // ── OTRAS COLECCIONES QUE USA LA APP Y FALTABAN AQUÍ ─
      // Límites de los reportes diarios (src/lib/reportesConfig.js)
      match /configuracion/{docId}         { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      // Documentos adjuntos a la ficha del trabajador (RRHH)
      match /documentos_trabajadores/{docId} { allow read: if isSuperAdmin() || leeSueldos(empresaId); allow write: if isSuperAdmin() || puedeRRHH(empresaId); }
      // Bitácora de cambios en reportes de combustible: se escribe una vez
      match /audit_log/{docId} {
        allow read:   if isSuperAdmin() || canWriteEmpresa(empresaId);
        allow create: if isSuperAdmin() || canWriteEmpresa(empresaId);
        allow update, delete: if isSuperAdmin();
      }
      match /finanzas_activos/{docId}      { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /finanzas_ingresos/{docId}     { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /finanzas_proveedores/{docId}  { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /deuda_proveedores/{docId}     { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /deuda_proveedores/{docId}/pagos/{pagoId} { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /deuda_acuerdos/{docId}        { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /deuda_financieras/{docId}     { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeFinanzas(empresaId); }
      match /centros_costo/{docId}         { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /fuelPrices/{docId}            { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /fuelPriceHistory/{docId}      { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /config/{docId}               { allow read: if isSuperAdmin() || canWriteEmpresa(empresaId); allow write: if esOficina(empresaId) || areaDe(empresaId, ['rrhh', 'contabilidad', 'finanzas'], 'rrhh|contabilidad|finanzas'); }
      match /guias_despacho/{docId}        { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /proveedores_pasajes/{docId}   { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /solicitudes_pasajes/{docId}   { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }

      // ── CONTABILIDAD Y COMBUSTIBLE ASOCIADOS ────────────
      match /chart_of_accounts/{docId}     { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeContabilidad(empresaId); }
      match /journal_entries/{docId}       { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeContabilidad(empresaId); }
      match /active_periods/{docId}        { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeContabilidad(empresaId); }
      match /reglas_gasto/{docId}          { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if areaDe(empresaId, ['contabilidad', 'finanzas'], 'contabilidad|finanzas'); }
      match /periods/{docId}               { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeContabilidad(empresaId); }
      match /flujo_mensual/{docId}         { allow read: if isSuperAdmin() || leeFinanzas(empresaId); allow write: if isSuperAdmin() || puedeContabilidad(empresaId); }
      match /combustible_calculos/{docId}  { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /combustible_maquinaria/{docId}{ allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }

      // ── BITÁCORAS DE AUDITORÍA ──────────────────────────
      // Registran quién eliminó, editó o reversó, y quién fusionó cuentas.
      // Se escriben una vez y no se tocan más: un registro de auditoría que se
      // puede editar o borrar no sirve para nada.
      match /deuda_auditoria/{docId} {
        allow read:   if isSuperAdmin() || leeFinanzas(empresaId);
        allow create: if isSuperAdmin() || puedeFinanzas(empresaId);
        allow update, delete: if isSuperAdmin();
      }

      // NUEVA — la escribe el módulo de Contabilidad al eliminar/editar/reversar
      // asientos, fusionar cuentas duplicadas o limpiar reglas de gasto.
      match /contabilidad_auditoria/{docId} {
        allow read:   if isSuperAdmin() || leeFinanzas(empresaId);
        allow create: if isSuperAdmin() || puedeContabilidad(empresaId);
        allow update, delete: if false;
      }

      // ── MÓDULO DOCUMENTOS (aislado por empresa) ──────────
      match /documentos/{docId}            { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId)
                                                                || (isMandante() && belongsToEmpresa(empresaId)); }
      match /folios/{docId}                { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId)
                                                                || (isMandante() && belongsToEmpresa(empresaId)); }

      // ── MÓDULO MAQUINARIA ────────────────────────────────
      match /maintenancePlans/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      match /maintenanceEvents/{docId} {
        allow read:   if isAuth() && belongsToEmpresa(empresaId);
        allow create: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
        // Normalmente los crea la Cloud Function closeWorkOrder (Admin SDK);
        // se permite create manual para mantenciones registradas fuera de una OT
        allow update, delete: if isSuperAdmin();
      }

      match /workOrders/{docId} {
        allow read:   if isAuth() && belongsToEmpresa(empresaId);
        allow create: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
        allow update: if isSuperAdmin()
                      || (belongsToEmpresa(empresaId) && canManageMaquinaria())
                      || (isMecanico() && belongsToEmpresa(empresaId)
                          && resource.data.asignadoA == request.auth.uid
                          && resource.data.estado != 'cerrada');
        allow delete: if isSuperAdmin(); // no se borran, se cancelan vía update de estado
      }

      match /failures/{docId} {
        allow read:   if isAuth() && belongsToEmpresa(empresaId);
        allow create: if isAuth() && belongsToEmpresa(empresaId); // cualquier rol de la empresa puede reportar
        allow update: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
        allow delete: if isSuperAdmin();
      }

      match /spareParts/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      match /sparePartMovements/{docId} {
        allow read:   if isAuth() && belongsToEmpresa(empresaId);
        allow create: if isSuperAdmin() || (belongsToEmpresa(empresaId) && (canManageMaquinaria() || isMecanico()));
        allow update, delete: if isSuperAdmin(); // kardex inmutable, solo se agregan movimientos nuevos
      }

      match /machineDocuments/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      match /machineHistory/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if false; // solo Cloud Functions con Admin SDK escriben aquí
      }

      // ── MPF RENTAL: clientes y contratos de arriendo ──
      match /rentalClients/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      match /rentalContracts/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      match /rentalQuotes/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      match /rentalPayments/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      // Órdenes de compra que emite el mandante. Abren y amplían (vía
      // enmienda) el monto autorizado del contrato, así que son el respaldo
      // de todo lo que se factura después.
      match /rentalPurchaseOrders/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      // Contadores de folios correlativos (COT / CTR / EP).
      // Se leen y escriben dentro de una transacción cada vez que se crea una
      // cotización, un contrato o un estado de pago: sin permiso de escritura
      // aquí, no se puede crear ninguno de los tres.
      // No se borran nunca: retroceder un correlativo genera folios repetidos.
      match /counters/{docId} {
        allow read:          if isAuth() && belongsToEmpresa(empresaId);
        // El correlativo de combustible lo usan los operadores de WorkFleet
        // (cualquier rol con escritura en la empresa); los demás, solo maquinaria.
        allow create, update: if isSuperAdmin()
                              || (belongsToEmpresa(empresaId) && canManageMaquinaria())
                              || (docId == 'combustible' && belongsToEmpresa(empresaId) && canWriteEmpresa(empresaId));
        allow delete:        if false;
      }
    }

    // ─────────────────────────────────────────────────────
    // /users raíz — para login y lectura de empresaId
    // Necesario porque AppSelector y useEmpresa leen de aquí
    // ─────────────────────────────────────────────────────
    match /users/{uid} {
      // ══════════════════════════════════════════════════════
      // Campos que definen los privilegios del usuario. Antes el dueño del
      // documento podía escribir cualquier cosa aquí, incluido
      // role:'superadmin' o el empresaId de otra empresa — y como
      // userRole() y userEmpresaId() leen justamente de este documento,
      // eso permitía saltarse por completo el aislamiento entre empresas.
      //
      // Ahora el usuario puede editar sus datos personales, pero no puede
      // tocar su rol, sus módulos ni su lista de empresas.
      // ══════════════════════════════════════════════════════
      function mismoValor(campo) {
        return request.resource.data.get(campo, null) == resource.data.get(campo, null);
      }

      // El usuario puede cambiar su empresa ACTIVA, pero solo a una empresa
      // que ya esté en su lista de membresías. Esa lista es inmutable para él.
      function empresaActivaValida() {
        return mismoValor('empresaId')
            || request.resource.data.empresaId in resource.data.get('empresasIds', []);
      }

      function noEscalaPrivilegios() {
        return mismoValor('role')
            && mismoValor('empresasIds')
            && mismoValor('modulos')
            && mismoValor('estado')
            && empresaActivaValida();
      }

      // ── Alta legítima de un usuario sobre su propio documento ──
      // Antes el `create` propio no revisaba nada: cualquiera que se
      // registrara podía escribirse role:'superadmin' y el empresaId de otra
      // empresa. Ahora el rol y la empresa solo se aceptan si vienen de uno
      // de estos caminos, que se pueden verificar contra otro documento:
      function empresaNueva() { return request.resource.data.get('empresaId', null); }
      function sinMembresiasExtra() {
        return request.resource.data.get('empresasIds', null) == null
            || request.resource.data.empresasIds == [empresaNueva()]
            || request.resource.data.get('empresasIds', []) == resource.data.get('empresasIds', []);
      }
      // 1. Dueño de la empresa: la empresa existe y dice que él es su admin
      //    (RegisterPage / EmpresaSetup crean la empresa con adminUid antes).
      function esDuenoDeEmpresa() {
        return request.resource.data.get('role', null) == 'admin_contrato'
            && empresaNueva() != null
            && exists(/databases/$(database)/documents/empresas/$(empresaNueva()))
            && (get(/databases/$(database)/documents/empresas/$(empresaNueva())).data.get('adminUid', '') == request.auth.uid
                || get(/databases/$(database)/documents/empresas/$(empresaNueva())).data.get('adminEmail', '_') == request.auth.token.email);
      }
      // 2. Invitación vigente: mismo rol y empresa que la invitación, y si
      //    tenía destinatario, el email de quien la acepta.
      function aceptaInvitacion() {
        let inv = request.resource.data.get('invitacionId', '');
        return inv != ''
            && exists(/databases/$(database)/documents/invitaciones/$(inv))
            && get(/databases/$(database)/documents/invitaciones/$(inv)).data.get('usada', false) == false
            && get(/databases/$(database)/documents/invitaciones/$(inv)).data.empresaId == empresaNueva()
            && get(/databases/$(database)/documents/invitaciones/$(inv)).data.rol == request.resource.data.get('role', null)
            && (get(/databases/$(database)/documents/invitaciones/$(inv)).data.get('emailDestino', '') == ''
                || get(/databases/$(database)/documents/invitaciones/$(inv)).data.emailDestino.lower() == request.auth.token.email.lower());
      }
      // 3. Operario que la empresa ya registró en trabajadores con su email.
      function esTrabajadorConEsteEmail() {
        let tid = request.resource.data.get('trabajadorId', '');
        return request.resource.data.get('role', null) == 'operador'
            && tid != '' && empresaNueva() != null
            && exists(/databases/$(database)/documents/empresas/$(empresaNueva())/trabajadores/$(tid))
            && get(/databases/$(database)/documents/empresas/$(empresaNueva())/trabajadores/$(tid)).data.get('email', '_').lower() == request.auth.token.email.lower();
      }
      // 4. Sin empresa todavía (cuenta recién creada, antes de elegir empresa).
      function sinEmpresaNiRol() {
        return empresaNueva() == null
            && request.resource.data.get('role', null) in [null, '', 'pendiente', 'operador']
            && request.resource.data.get('empresasIds', []).size() == 0;
      }
      function altaPropiaValida() {
        return sinMembresiasExtra()
            && !(request.resource.data.get('role', null) in ['superadmin', 'mandante_admin'])
            && (esDuenoDeEmpresa() || aceptaInvitacion() || esTrabajadorConEsteEmail() || sinEmpresaNiRol());
      }

      // ── Lo que un admin de empresa puede escribir en el doc de otro ──
      // No puede dar 'superadmin' ni agregar empresas de las que él no es miembro.
      function adminNoEscala() {
        let nuevas = request.resource.data.get('empresasIds', []).toSet()
                       .difference((resource == null ? [] : resource.data.get('empresasIds', [])).toSet());
        return (request.resource.data.get('role', null) != 'superadmin'
                || (resource != null && resource.data.get('role', null) == 'superadmin'))
            && nuevas.hasOnly(misEmpresas());
      }

      // Permiso unificado con cortocircuito para evitar recursión y habilitar listados masivos
      allow read: if isAuth() && (
                    request.auth.uid == uid
                    || isSuperAdmin()
                    || (resource != null && (isAnyAdmin() || isMandanteAdmin())
                        && esMiembroDe(resource.data.get('empresaId', '__ninguna__')))
                  );

      // Permisos de creación
      allow create: if isAuth() && (
                      (request.auth.uid == uid && altaPropiaValida())
                      || isSuperAdmin()
                      || (isAnyAdmin() && (request.resource.data.role == 'trabajador' || request.resource.data.role == 'operador')
                          && esMiembroDe(request.resource.data.empresaId) && adminNoEscala())
                    );

      // Permisos de actualización
      allow update: if isAuth() && (
                      // El propio usuario: solo datos no privilegiados + cambio de empresa activa
                      (request.auth.uid == uid && (noEscalaPrivilegios()
                          // cuenta que aún no tenía empresa y ahora la recibe por un camino válido
                          || (resource.data.get('empresaId', null) == null && altaPropiaValida())
                          // invitación aceptada con una cuenta que ya existía
                          || (aceptaInvitacion() && sinMembresiasExtra())))
                      || isSuperAdmin()
                      // Un admin gestiona usuarios de las empresas donde él es miembro,
                      // sin poder dar superadmin ni membresías que él no tiene
                      || (isAnyAdmin()
                          && (resource.data.get('empresaId', null) == null
                              || esMiembroDe(resource.data.empresaId))
                          && esMiembroDe(request.resource.data.empresaId)
                          && adminNoEscala())
                    );

      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    // /plataforma — configuración global de la plataforma.
    // plataforma/mejoras.aprobadores = [uid, ...] define quién puede aprobar
    // y publicar cambios de código pedidos al agente IA (api/mejoras).
    // Va aparte de /users porque cada usuario puede editar su propio
    // documento: ahí podría darse el permiso a sí mismo.
    // ─────────────────────────────────────────────────────
    match /plataforma/{docId} {
      allow read:  if isAuth();
      allow write: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    // /subscriptions — usePlan hook lee/escucha el plan activo
    // ─────────────────────────────────────────────────────
    match /subscriptions/{docId} {
      // El plan lo activan el superadmin o los webhooks de pago (Admin SDK).
      // Desde la app solo se crea el período de prueba de una empresa nueva;
      // antes un admin (o cualquiera, en subscriptions/{su uid}) podía
      // escribirse status:'authorized'.
      allow read: if isSuperAdmin()
                  || (isAuth() && (docId == request.auth.uid || esMiembroDe(docId)
                                   || resource.data.get('empresaId', '__ninguna__') in misEmpresas()));
      allow create: if isSuperAdmin()
                    || (isAuth()
                        && (docId == request.auth.uid
                            || (exists(/databases/$(database)/documents/empresas/$(docId))
                                && get(/databases/$(database)/documents/empresas/$(docId)).data.get('adminUid', '') == request.auth.uid))
                        && request.resource.data.get('status', '') == 'trial'
                        && request.resource.data.get('planId', '') in ['', 'starter']);
      // Mi Plan (AdminPanel) hoy cambia módulos con un pago simulado
      // ("mock_webpay"): mientras el cobro real no esté conectado, el admin de
      // la empresa sigue pudiendo actualizar SU suscripción.
      allow update: if isSuperAdmin() || (isAdminContrato() && docId == userEmpresaId());
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    // Precios combustible root — legacy, solo superadmin
    // Los datos nuevos van en empresas/{empresaId}/fuelPrices y /fuelPriceHistory
    // ─────────────────────────────────────────────────────
    match /fuelPrices/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /fuelPriceHistory/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /fuelPriceCache/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    // /invitaciones — sistema de invitaciones de empresa
    // ─────────────────────────────────────────────────────
    match /invitaciones/{token} {
      // Se lee por su token (id aleatorio) para validarla al aceptar, incluso
      // sin sesión. Listar invitaciones queda para los admins de esa empresa.
      allow get:  if true;
      allow list: if isSuperAdmin()
                  || ((isAdminContrato() || isMandanteAdmin()) && resource.data.empresaId == userEmpresaId());
      // superadmin puede crear cualquier invitación
      // admin_contrato puede crear invitaciones solo para su empresa
      // mandante_admin puede crear invitaciones de rol mandante para su empresa
      allow create: if isSuperAdmin()
                    || (isAdminContrato() && request.resource.data.empresaId == userEmpresaId())
                    || (isMandanteAdmin() && request.resource.data.empresaId == userEmpresaId()
                        && request.resource.data.rol == 'mandante');
      // Marcar una invitación como usada. Se acota a eso: antes cualquier usuario
      // autenticado podía reescribir el documento completo, incluido el rol y la
      // empresa a la que da acceso.
      // Solo se marca como usada, por quien la acepta, y una sola vez.
      allow update: if isSuperAdmin()
                    || (isAuth()
                        && resource.data.get('usada', false) == false
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usada', 'usadaPor', 'usadaEn'])
                        && request.resource.data.usadaPor == request.auth.uid);
      // Solo admins pueden revocar
      allow delete: if isAnyAdmin();
    }

    // ─────────────────────────────────────────────────────
    // DOCUMENTOS Y FIRMAS — root legacy, superadmin solo
    // Los datos nuevos van en empresas/{empresaId}/documentos y /folios
    // ─────────────────────────────────────────────────────
    match /documentos/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /folios/{docId} {
      allow read, write: if isSuperAdmin();
    }
    // pins y usuarios: sistema custom de auth del módulo documentos (no Firebase Auth)
    // Solo necesita ser accedido por cualquier usuario autenticado (no hay empresaId en estos docs)
    match /pins/{usuario} {
      // El hash se lee para verificar la firma. Crear: solo si no existe (y
      // queda con el uid de quien lo crea). Cambiar: solo su dueño. Antes
      // cualquier usuario autenticado podía reemplazar el PIN de otro y
      // firmar en su nombre.
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.get('uid', null) == request.auth.uid;
      allow update: if isSuperAdmin()
                    || (isAuth() && resource.data.get('uid', null) == request.auth.uid
                        && request.resource.data.get('uid', null) == request.auth.uid);
      allow delete: if isSuperAdmin();
    }
    match /usuarios/{usuario} {
      // Guarda el pinHash con que se firma: igual que /pins, se crea con el uid
      // de su dueño y solo él lo cambia. Un admin puede cambiar únicamente el
      // estado (RRHH lo usa al desvincular o finiquitar).
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.get('uid', null) == request.auth.uid;
      allow update: if isSuperAdmin()
                    || (isAuth() && resource.data.get('uid', null) == request.auth.uid
                        && request.resource.data.get('uid', null) == request.auth.uid)
                    || (isAnyAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }
    match /libros/{docId} {
      allow read: if isAuth();
      allow write: if isAnyAdmin();
    }

    // ─────────────────────────────────────────────────────
    // /domains & /mailboxes — Email Portal
    // ─────────────────────────────────────────────────────
    match /domains/{domainName} {
      allow read: if isAuth() && (isSuperAdmin() || (resource != null && resource.data.empresaId == userEmpresaId()));
      allow write: if isSuperAdmin();
    }

    match /mailboxes/{mailboxId} {
      allow read: if isAuth() && (isSuperAdmin() || (resource != null && resource.data.empresaId == userEmpresaId()));
      allow write: if isSuperAdmin();
    }

    // Permisos para consulta de colección grupo trabajadores (auto-vinculación de operarios por email)
    match /{path=**}/trabajadores/{trabajadorId} {
      allow read: if isAuth() && resource != null && (resource.data.email == request.auth.token.email || resource.data.get('portalEmail', '') == request.auth.token.email);
    }

    // ─────────────────────────────────────────────────────
    // DEFAULT — denegar todo lo no especificado
    // ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
