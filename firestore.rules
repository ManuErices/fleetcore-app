rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────────────

    // Usuario autenticado
    function isAuth() {
      return request.auth != null;
    }

    // Lee el doc del usuario desde /users/{uid}
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Rol del usuario
    function userRole() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? userData().role : null;
    }

    // EmpresaId ACTIVO del usuario (la empresa en la que está trabajando ahora)
    function userEmpresaId() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? userData().empresaId : null;
    }

    // ── MULTIEMPRESA ─────────────────────────────────────
    // Lista de empresas a las que el usuario pertenece. Es la fuente de
    // verdad de la membresía y SOLO un admin puede modificarla (ver la
    // regla de /users/{uid} más abajo).
    //
    // El fallback a [empresaId] mantiene funcionando a los usuarios que
    // todavía no han pasado por la migración: siguen viendo su empresa
    // de siempre y nada se rompe.
    function misEmpresas() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userData().get('empresasIds', userEmpresaId() != null ? [userEmpresaId()] : [])
        : [];
    }

    // ¿El usuario es miembro de esta empresa? (activa o no)
    function esMiembroDe(empresaId) {
      return isAuth() && (userEmpresaId() == empresaId || empresaId in misEmpresas());
    }

    // Superadmin global — acceso total a todo
    function isSuperAdmin() {
      return isAuth() && userRole() == 'superadmin';
    }

    // Admin de contrato — acceso total dentro de su empresa
    function isAdminContrato() {
      return isAuth() && userRole() == 'admin_contrato';
    }

    // Mandante admin — puede gestionar usuarios mandante de su empresa
    function isMandanteAdmin() {
      return isAuth() && userRole() == 'mandante_admin';
    }

    // Cualquier admin (superadmin o admin_contrato)
    function isAnyAdmin() {
      return isSuperAdmin() || isAdminContrato();
    }

    // Usuario pertenece a esta empresa.
    // Antes solo comparaba contra la empresa activa; ahora acepta cualquiera
    // de sus membresías, porque al cambiar de empresa hay un instante en que
    // el cliente ya pide datos de la nueva mientras el doc de usuario aún
    // viaja. La separación de datos la hace la interfaz mostrando una sola
    // empresa a la vez; las reglas solo verifican que tenga derecho a ambas.
    function belongsToEmpresa(empresaId) {
      return esMiembroDe(empresaId);
    }

    // Usuario tiene acceso de lectura/escritura a la empresa
    // (cualquier rol excepto trabajador y mandante pueden operar)
    function canWriteEmpresa(empresaId) {
      return belongsToEmpresa(empresaId)
          && userRole() != 'trabajador'
          && userRole() != 'mandante';
    }

    // Trabajador autenticado con cuenta @mpf.cl (u otro dominio de empresa)
    function isTrabajador() {
      return isAuth()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userRole() == 'trabajador'
          && userData().get('estado', 'activo') == 'activo';
    }

    // Mandante — solo lectura
    function isMandante() {
      return isAuth() && userRole() == 'mandante';
    }

    // Jefe de taller — módulo Maquinaria
    function isJefeTaller() {
      return isAuth() && userRole() == 'jefe_taller';
    }

    // Mecánico — módulo Maquinaria
    function isMecanico() {
      return isAuth() && userRole() == 'mecanico';
    }

    // Puede gestionar el módulo Maquinaria (crear OT, planes, cerrar, stock)
    function canManageMaquinaria() {
      return isSuperAdmin() || isAdminContrato() || userRole() == 'administrativo' || isJefeTaller();
    }

    // ── NUEVO ────────────────────────────────────────────
    // Id de la ficha de trabajador vinculada a quien hace la petición.
    // El portal guarda el índice uid → trabajadorDocId en trabajadores_portal.
    // Se usa para que un trabajador solo pueda operar sobre lo suyo.
    function miTrabajadorDocId(empresaId) {
      return exists(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid))
        ? get(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid)).data.trabajadorDocId
        : null;
    }

    // ─────────────────────────────────────────────────────
    // COLECCIONES GLOBALES (solo superadmin)
    // ─────────────────────────────────────────────────────

    match /settings/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /subscription_intents/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    // EMPRESAS — solo superadmin puede crear/listar empresas
    //            admin_contrato puede leer su propia empresa
    // ─────────────────────────────────────────────────────

    match /empresas/{empresaId} {
      allow read:  if isAuth();
      // Superadmin puede todo; usuario nuevo puede crear su primera empresa (sin empresaId aún);
      // O un administrador/usuario autorizado puede crear una sub-empresa
      allow create: if isSuperAdmin()
                    || (isAuth() && !exists(/databases/$(database)/documents/users/$(request.auth.uid)))
                    || (isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('empresaId', null) == null)
                    || (isAuth() && request.resource.data.get('parentEmpresaId', null) == userEmpresaId() && canWriteEmpresa(userEmpresaId()));
      // admin_contrato puede editar su propia empresa raíz
      // superadmin puede todo
      // canWriteEmpresa permite editar sub-empresas propias
      allow update: if isSuperAdmin()
                    || (isAdminContrato() && userEmpresaId() == empresaId)
                    || (isAuth() && resource.data.get('parentEmpresaId', null) == userEmpresaId() && canWriteEmpresa(userEmpresaId()));
      allow delete: if isSuperAdmin()
                    || (isAuth() && resource.data.get('parentEmpresaId', null) == userEmpresaId() && canWriteEmpresa(userEmpresaId()));

      // ── USUARIOS DE LA EMPRESA ──────────────────────────
      match /users/{uid} {
        allow read:  if isAuth() && (
                       request.auth.uid == uid
                       || isSuperAdmin()
                       || (userEmpresaId() == empresaId && isAnyAdmin())
                     );
        allow write: if isAuth() && (
                       request.auth.uid == uid
                       || isSuperAdmin()
                       || (isAdminContrato() && userEmpresaId() == empresaId)
                     );
      }

      // ── TRABAJADORES ────────────────────────────────────
      match /trabajadores/{trabajadorId} {
        allow read, write: if isSuperAdmin()
                           || (canWriteEmpresa(empresaId));
        // Trabajador lee su propio perfil
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && (resource == null || resource.data.portalUid == request.auth.uid);
        // Trabajador crea su propio registro al aceptar una invitación
        allow create: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && request.resource.data.portalUid == request.auth.uid;
      }

      match /trabajadores_portal/{uid} {
        allow read:  if isAuth() && request.auth.uid == uid;
        allow write: if isSuperAdmin()
                     || (canWriteEmpresa(empresaId));
        // Trabajador crea su propio vínculo al aceptar una invitación
        allow create: if isAuth() && request.auth.uid == uid
                    && belongsToEmpresa(empresaId)
                    && isTrabajador();
      }

      // ── CONTRATOS, ANEXOS, FINIQUITOS ───────────────────
      match /contratos/{docId} {
        allow read, write: if isSuperAdmin()
                           || canWriteEmpresa(empresaId);
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && (resource == null || (resource.data.trabajadorId != null
                    && existsAfter(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid))
                    && get(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid)).data.trabajadorDocId == resource.data.trabajadorId));
      }

      match /finiquitos/{docId} {
        allow read, write: if isSuperAdmin()
                           || canWriteEmpresa(empresaId);
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && (resource == null || (resource.data.trabajadorId != null
                    && get(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid)).data.trabajadorDocId == resource.data.trabajadorId));
      }

      match /anexos/{docId} {
        allow read, write: if isSuperAdmin()
                           || canWriteEmpresa(empresaId);
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && (resource == null || (resource.data.trabajadorId != null
                    && get(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid)).data.trabajadorDocId == resource.data.trabajadorId));
      }

      // ── REMUNERACIONES ───────────────────────────────────
      match /remuneraciones/{docId} {
        allow read, write: if isSuperAdmin()
                           || canWriteEmpresa(empresaId);
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && (resource == null || (resource.data.trabajadorId != null
                    && get(/databases/$(database)/documents/empresas/$(empresaId)/trabajadores_portal/$(request.auth.uid)).data.trabajadorDocId == resource.data.trabajadorId));
      }

      // ── ASISTENCIA ───────────────────────────────────────
      match /asistencia/{docId} {
        allow read, write: if isSuperAdmin()
                           || canWriteEmpresa(empresaId);
        allow read: if isTrabajador()
                    && belongsToEmpresa(empresaId)
                    && (resource == null || resource.data.trabajadorId == request.auth.uid);
        allow create: if isTrabajador()
                      && belongsToEmpresa(empresaId)
                      && request.resource.data.trabajadorId == request.auth.uid;
        allow update: if isTrabajador()
                      && belongsToEmpresa(empresaId)
                      && resource.data.trabajadorId == request.auth.uid;
      }

      // ── TURNOS Y ASIGNACIONES ────────────────────────────
      match /turnos/{docId} {
        allow read: if belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || canWriteEmpresa(empresaId);
      }

      match /asignaciones_turnos/{docId} {
        allow read: if belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || canWriteEmpresa(empresaId);
      }

      // ── VACACIONES ───────────────────────────────────────
      // CAMBIO: antes un trabajador podía crear una solicitud a nombre de
      // cualquier otro y en cualquier estado — incluido 'aprobada', o sea,
      // autoaprobarse. Ahora la solicitud tiene que ser suya y nacer pendiente.
      // La aprobación sigue siendo exclusiva de RRHH.
      match /vacaciones/{docId} {
        allow read: if belongsToEmpresa(empresaId);

        allow create: if isSuperAdmin()
                      || canWriteEmpresa(empresaId)
                      || (isTrabajador()
                          && belongsToEmpresa(empresaId)
                          && request.resource.data.trabajadorId == miTrabajadorDocId(empresaId)
                          && request.resource.data.estado == 'pendiente');

        // El trabajador puede corregir su solicitud mientras siga pendiente,
        // sin cambiarle el dueño ni el estado.
        allow update: if isSuperAdmin()
                      || canWriteEmpresa(empresaId)
                      || (isTrabajador()
                          && belongsToEmpresa(empresaId)
                          && resource.data.trabajadorId == miTrabajadorDocId(empresaId)
                          && resource.data.estado == 'pendiente'
                          && request.resource.data.estado == 'pendiente'
                          && request.resource.data.trabajadorId == resource.data.trabajadorId);

        allow delete: if isSuperAdmin() || canWriteEmpresa(empresaId);
      }

      match /ausencias/{docId} {
        allow read: if belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || canWriteEmpresa(empresaId);
      }

      // ── REPORTES WORKFLEET (mandante puede leer) ─────────
      match /reportes_detallados/{docId} {
        allow read:  if isSuperAdmin()
                     || canWriteEmpresa(empresaId)
                     || (isMandante() && belongsToEmpresa(empresaId));
        allow write: if isSuperAdmin()
                     || canWriteEmpresa(empresaId);
      }

      match /reportes_combustible/{docId} {
        allow read:  if isSuperAdmin()
                     || canWriteEmpresa(empresaId)
                     || (isMandante() && belongsToEmpresa(empresaId));
        allow write: if isSuperAdmin()
                     || canWriteEmpresa(empresaId);
      }

      // ── RESTO DE COLECCIONES DE EMPRESA ──────────────────
      // Acceso completo para admins y roles operativos de la empresa
      match /projects/{docId}              { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /machines/{docId}              { allow read: if isAuth(); allow write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /dailyLogs/{docId}             { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /fuelLogs/{docId}              { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /employees/{docId}             { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /employeeMonthlyData/{docId}   { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /employeeAssignments/{docId}   { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /purchaseOrders/{docId}        { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /rendiciones/{docId}           { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /subcontratos/{docId}          { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /estadoPagoIngresos/{docId}    { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /combustibleRegistros/{docId}      { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /combustiblePrecioMensual/{docId}  { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /actividades_disponibles/{docId} { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /bandas_salariales/{docId}     { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /catalogo_maquinas/{docId}     { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /costos_fijos/{docId}          { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /empresas_combustible/{docId}  { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /equipos_surtidores/{docId}    { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /estaciones_combustible/{docId}{ allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /flujo_config/{docId}          { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /flujo_cuentas/{docId}         { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /flujo_pagados/{docId}         { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /flujo_notas/{docId}           { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /flujo_pagos/{docId}           { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /finanzas_activos/{docId}      { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /finanzas_ingresos/{docId}     { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /finanzas_proveedores/{docId}  { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /deuda_proveedores/{docId}     { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /deuda_proveedores/{docId}/pagos/{pagoId} { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /deuda_acuerdos/{docId}        { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /deuda_financieras/{docId}     { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /centros_costo/{docId}         { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /fuelPrices/{docId}            { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /fuelPriceHistory/{docId}      { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /config/{docId}               { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /guias_despacho/{docId}        { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /proveedores_pasajes/{docId}   { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /solicitudes_pasajes/{docId}   { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }

      // ── CONTABILIDAD Y COMBUSTIBLE ASOCIADOS ────────────
      match /chart_of_accounts/{docId}     { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /journal_entries/{docId}       { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /active_periods/{docId}        { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /reglas_gasto/{docId}          { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /periods/{docId}               { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /flujo_mensual/{docId}         { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /combustible_calculos/{docId}  { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }
      match /combustible_maquinaria/{docId}{ allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId); }

      // ── BITÁCORAS DE AUDITORÍA ──────────────────────────
      // Registran quién eliminó, editó o reversó, y quién fusionó cuentas.
      // Se escriben una vez y no se tocan más: un registro de auditoría que se
      // puede editar o borrar no sirve para nada.
      match /deuda_auditoria/{docId} {
        allow read:   if isSuperAdmin() || canWriteEmpresa(empresaId);
        allow create: if isSuperAdmin() || canWriteEmpresa(empresaId);
        allow update, delete: if isSuperAdmin();
      }

      // NUEVA — la escribe el módulo de Contabilidad al eliminar/editar/reversar
      // asientos, fusionar cuentas duplicadas o limpiar reglas de gasto.
      match /contabilidad_auditoria/{docId} {
        allow read:   if isSuperAdmin() || canWriteEmpresa(empresaId);
        allow create: if isSuperAdmin() || canWriteEmpresa(empresaId);
        allow update, delete: if false;
      }

      // ── MÓDULO DOCUMENTOS (aislado por empresa) ──────────
      match /documentos/{docId}            { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId)
                                                                || (isMandante() && belongsToEmpresa(empresaId)); }
      match /folios/{docId}                { allow read, write: if isSuperAdmin() || canWriteEmpresa(empresaId)
                                                                || (isMandante() && belongsToEmpresa(empresaId)); }

      // ── MÓDULO MAQUINARIA ────────────────────────────────
      match /maintenancePlans/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      match /maintenanceEvents/{docId} {
        allow read:   if isAuth() && belongsToEmpresa(empresaId);
        allow create: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
        // Normalmente los crea la Cloud Function closeWorkOrder (Admin SDK);
        // se permite create manual para mantenciones registradas fuera de una OT
        allow update, delete: if isSuperAdmin();
      }

      match /workOrders/{docId} {
        allow read:   if isAuth() && belongsToEmpresa(empresaId);
        allow create: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
        allow update: if isSuperAdmin()
                      || (belongsToEmpresa(empresaId) && canManageMaquinaria())
                      || (isMecanico() && belongsToEmpresa(empresaId)
                          && resource.data.asignadoA == request.auth.uid
                          && resource.data.estado != 'cerrada');
        allow delete: if isSuperAdmin(); // no se borran, se cancelan vía update de estado
      }

      match /failures/{docId} {
        allow read:   if isAuth() && belongsToEmpresa(empresaId);
        allow create: if isAuth() && belongsToEmpresa(empresaId); // cualquier rol de la empresa puede reportar
        allow update: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
        allow delete: if isSuperAdmin();
      }

      match /spareParts/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      match /sparePartMovements/{docId} {
        allow read:   if isAuth() && belongsToEmpresa(empresaId);
        allow create: if isSuperAdmin() || (belongsToEmpresa(empresaId) && (canManageMaquinaria() || isMecanico()));
        allow update, delete: if isSuperAdmin(); // kardex inmutable, solo se agregan movimientos nuevos
      }

      match /machineDocuments/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      match /machineHistory/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if false; // solo Cloud Functions con Admin SDK escriben aquí
      }

      // ── MPF RENTAL: clientes y contratos de arriendo ──
      match /rentalClients/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      match /rentalContracts/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      match /rentalQuotes/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      match /rentalPayments/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      // Órdenes de compra que emite el mandante. Abren y amplían (vía
      // enmienda) el monto autorizado del contrato, así que son el respaldo
      // de todo lo que se factura después.
      match /rentalPurchaseOrders/{docId} {
        allow read:  if isAuth() && belongsToEmpresa(empresaId);
        allow write: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
      }

      // Contadores de folios correlativos (COT / CTR / EP).
      // Se leen y escriben dentro de una transacción cada vez que se crea una
      // cotización, un contrato o un estado de pago: sin permiso de escritura
      // aquí, no se puede crear ninguno de los tres.
      // No se borran nunca: retroceder un correlativo genera folios repetidos.
      match /counters/{docId} {
        allow read:          if isAuth() && belongsToEmpresa(empresaId);
        allow create, update: if isSuperAdmin() || (belongsToEmpresa(empresaId) && canManageMaquinaria());
        allow delete:        if false;
      }
    }

    // ─────────────────────────────────────────────────────
    // /users raíz — para login y lectura de empresaId
    // Necesario porque AppSelector y useEmpresa leen de aquí
    // ─────────────────────────────────────────────────────
    match /users/{uid} {
      // ══════════════════════════════════════════════════════
      // Campos que definen los privilegios del usuario. Antes el dueño del
      // documento podía escribir cualquier cosa aquí, incluido
      // role:'superadmin' o el empresaId de otra empresa — y como
      // userRole() y userEmpresaId() leen justamente de este documento,
      // eso permitía saltarse por completo el aislamiento entre empresas.
      //
      // Ahora el usuario puede editar sus datos personales, pero no puede
      // tocar su rol, sus módulos ni su lista de empresas.
      // ══════════════════════════════════════════════════════
      function mismoValor(campo) {
        return request.resource.data.get(campo, null) == resource.data.get(campo, null);
      }

      // El usuario puede cambiar su empresa ACTIVA, pero solo a una empresa
      // que ya esté en su lista de membresías. Esa lista es inmutable para él.
      function empresaActivaValida() {
        return mismoValor('empresaId')
            || request.resource.data.empresaId in resource.data.get('empresasIds', []);
      }

      function noEscalaPrivilegios() {
        return mismoValor('role')
            && mismoValor('empresasIds')
            && mismoValor('modulos')
            && mismoValor('estado')
            && empresaActivaValida();
      }

      // Permiso unificado con cortocircuito para evitar recursión y habilitar listados masivos
      allow read: if isAuth() && (
                    request.auth.uid == uid
                    || isSuperAdmin()
                    || (resource != null && (isAnyAdmin() || isMandanteAdmin())
                        && esMiembroDe(resource.data.get('empresaId', '__ninguna__')))
                  );

      // Permisos de creación
      allow create: if isAuth() && (
                      request.auth.uid == uid
                      || isSuperAdmin()
                      || (isAnyAdmin() && (request.resource.data.role == 'trabajador' || request.resource.data.role == 'operador')
                          && esMiembroDe(request.resource.data.empresaId))
                    );

      // Permisos de actualización
      allow update: if isAuth() && (
                      // El propio usuario: solo datos no privilegiados + cambio de empresa activa
                      (request.auth.uid == uid && noEscalaPrivilegios())
                      || isSuperAdmin()
                      // Un admin gestiona usuarios de las empresas donde él es miembro
                      || (isAnyAdmin()
                          && (resource.data.get('empresaId', null) == null
                              || esMiembroDe(resource.data.empresaId))
                          && esMiembroDe(request.resource.data.empresaId))
                    );

      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    // /subscriptions — usePlan hook lee/escucha el plan activo
    // ─────────────────────────────────────────────────────
    match /subscriptions/{docId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin() || (isAdminContrato() && docId == userEmpresaId());
      allow create, update: if isAuth() && request.auth.uid == docId;
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    // Precios combustible root — legacy, solo superadmin
    // Los datos nuevos van en empresas/{empresaId}/fuelPrices y /fuelPriceHistory
    // ─────────────────────────────────────────────────────
    match /fuelPrices/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /fuelPriceHistory/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /fuelPriceCache/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    // /invitaciones — sistema de invitaciones de empresa
    // ─────────────────────────────────────────────────────
    match /invitaciones/{token} {
      // Cualquiera puede leer una invitación (para validarla al aceptar)
      allow read: if true;
      // superadmin puede crear cualquier invitación
      // admin_contrato puede crear invitaciones solo para su empresa
      // mandante_admin puede crear invitaciones de rol mandante para su empresa
      allow create: if isSuperAdmin()
                    || (isAdminContrato() && request.resource.data.empresaId == userEmpresaId())
                    || (isMandanteAdmin() && request.resource.data.empresaId == userEmpresaId()
                        && request.resource.data.rol == 'mandante');
      // Marcar una invitación como usada. Se acota a eso: antes cualquier usuario
      // autenticado podía reescribir el documento completo, incluido el rol y la
      // empresa a la que da acceso.
      allow update: if isAuth()
                    && request.resource.data.empresaId == resource.data.empresaId
                    && request.resource.data.rol == resource.data.rol;
      // Solo admins pueden revocar
      allow delete: if isAnyAdmin();
    }

    // ─────────────────────────────────────────────────────
    // DOCUMENTOS Y FIRMAS — root legacy, superadmin solo
    // Los datos nuevos van en empresas/{empresaId}/documentos y /folios
    // ─────────────────────────────────────────────────────
    match /documentos/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /folios/{docId} {
      allow read, write: if isSuperAdmin();
    }
    // pins y usuarios: sistema custom de auth del módulo documentos (no Firebase Auth)
    // Solo necesita ser accedido por cualquier usuario autenticado (no hay empresaId en estos docs)
    match /pins/{usuario} {
      allow read, write: if isAuth() && (
        !exists(/databases/$(database)/documents/usuarios/$(usuario))
        || get(/databases/$(database)/documents/usuarios/$(usuario)).data.get('estado', 'activo') == 'activo'
        || isSuperAdmin()
      );
    }
    match /usuarios/{usuario} {
      allow read: if isAuth();
      allow write: if isAuth() && (
        !exists(/databases/$(database)/documents/usuarios/$(usuario))
        || resource.data.get('estado', 'activo') == 'activo'
        || isSuperAdmin()
      );
    }
    match /libros/{docId} {
      allow read: if isAuth();
      allow write: if isAnyAdmin();
    }

    // ─────────────────────────────────────────────────────
    // /domains & /mailboxes — Email Portal
    // ─────────────────────────────────────────────────────
    match /domains/{domainName} {
      allow read: if isAuth() && (isSuperAdmin() || (resource != null && resource.data.empresaId == userEmpresaId()));
      allow write: if isSuperAdmin();
    }

    match /mailboxes/{mailboxId} {
      allow read: if isAuth() && (isSuperAdmin() || (resource != null && resource.data.empresaId == userEmpresaId()));
      allow write: if isSuperAdmin();
    }

    // Permisos para consulta de colección grupo trabajadores (auto-vinculación de operarios por email)
    match /{path=**}/trabajadores/{trabajadorId} {
      allow read: if isAuth() && resource != null && (resource.data.email == request.auth.token.email || resource.data.get('portalEmail', '') == request.auth.token.email);
    }

    // ─────────────────────────────────────────────────────
    // DEFAULT — denegar todo lo no especificado
    // ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
