rules_version = '2';

// ════════════════════════════════════════════════════════════
// Firebase Storage Rules — FleetCore
//
// IMPORTANTE: si ya tienes un archivo storage.rules con reglas de
// otros módulos, NO lo reemplaces entero — copia SOLO los bloques
// match /empresas/... de abajo dentro de tu bloque
// `match /b/{bucket}/o { ... }` existente.
//
// Desplegar con:  firebase deploy --only storage
// ════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ──────────────────────────────────────────────
    function autenticado() {
      return request.auth != null;
    }

    function esPdfOImagen() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }

    // Word .doc y .docx: varios certificados y contratos llegan así
    function esWord() {
      return request.resource.contentType == 'application/msword'
          || request.resource.contentType ==
             'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
    }

    // Documentos de equipos (leasing, permiso circulación, SOAP, etc.)
    match /empresas/{empresaId}/machineDocuments/{machineId}/{fileName} {
      allow read:  if autenticado();
      // Subida: cualquier usuario autenticado de la empresa (el control fino
      // de rol se hace en Firestore sobre la colección machineDocuments).
      // Límite de 15 MB y solo PDF o imágenes.
      allow write: if autenticado()
                   && request.resource.size < 15 * 1024 * 1024
                   && esPdfOImagen();
      allow delete: if autenticado();
    }

    // Fotos de respaldo de órdenes de trabajo (checklist de mantención)
    match /empresas/{empresaId}/workOrders/{workOrderId}/{fileName} {
      allow read:  if autenticado();
      allow write: if autenticado()
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if autenticado();
    }

    // ════════════════════════════════════════════════════════
    // RRHH — Documentos de trabajadores
    //
    // Ruta que ya escribe HistorialModal (pestaña "Documentos"):
    //   empresas/{empresaId}/documentos/{trabajadorId}/{timestamp}_{nombre}
    //
    // Sin esta regla toda subida fallaba con storage/unauthorized: el
    // código existía, faltaba el permiso.
    //
    // Contenido sensible (contratos, licencias médicas, certificados),
    // por eso el límite es más bajo que el de máquinas. Los tipos
    // aceptados calzan con TIPOS_PERMITIDOS del componente de subida.
    // ════════════════════════════════════════════════════════
    match /empresas/{empresaId}/documentos/{trabajadorId}/{fileName} {
      allow read:  if autenticado();
      allow write: if autenticado()
                   && request.resource.size < 10 * 1024 * 1024
                   && (esPdfOImagen() || esWord());
      allow delete: if autenticado();
    }

    // Anexos de contrato firmados y escaneados (los sube SubirDocumentoAnexo)
    match /empresas/{empresaId}/anexos/{trabajadorId}/{fileName} {
      allow read:  if autenticado();
      allow write: if autenticado()
                   && request.resource.size < 10 * 1024 * 1024
                   && (esPdfOImagen() || esWord());
      allow delete: if autenticado();
    }

    // ════════════════════════════════════════════════════════
    // MPF RENTAL — respaldos del ciclo comercial
    //
    // Una carpeta por tipo de documento, todas con la misma forma:
    //   empresas/{empresaId}/{coleccion}/{docId}/{timestamp}_{nombre}
    //
    // Qué guarda cada una:
    //   rentalClients        certificado de estatutos, e-RUT, poderes
    //   rentalQuotes         cotización enviada, correos del cliente
    //   rentalPurchaseOrders OC del mandante y sus enmiendas
    //   rentalContracts      contrato firmado, anexos, actas de entrega
    //   rentalPayments       factura, aprobación del mandante, guías
    //
    // El límite de 15 MB calza con MAX_ARCHIVO_MB de src/lib/rental.js.
    // Se acepta Word además de PDF e imagen porque varios certificados y
    // contratos llegan en .doc o .docx.
    // ════════════════════════════════════════════════════════
    match /empresas/{empresaId}/rentalClients/{docId}/{fileName} {
      allow read:   if autenticado();
      allow write:  if autenticado()
                    && request.resource.size < 15 * 1024 * 1024
                    && (esPdfOImagen() || esWord());
      allow delete: if autenticado();
    }

    match /empresas/{empresaId}/rentalQuotes/{docId}/{fileName} {
      allow read:   if autenticado();
      allow write:  if autenticado()
                    && request.resource.size < 15 * 1024 * 1024
                    && (esPdfOImagen() || esWord());
      allow delete: if autenticado();
    }

    match /empresas/{empresaId}/rentalPurchaseOrders/{docId}/{fileName} {
      allow read:   if autenticado();
      allow write:  if autenticado()
                    && request.resource.size < 15 * 1024 * 1024
                    && (esPdfOImagen() || esWord());
      allow delete: if autenticado();
    }

    match /empresas/{empresaId}/rentalContracts/{docId}/{fileName} {
      allow read:   if autenticado();
      allow write:  if autenticado()
                    && request.resource.size < 15 * 1024 * 1024
                    && (esPdfOImagen() || esWord());
      allow delete: if autenticado();
    }

    // La factura es el respaldo tributario del cobro: se sube, no se pisa.
    // Si hay que corregirla, se anula el estado de pago y se emite otro.
    match /empresas/{empresaId}/rentalPayments/{docId}/{fileName} {
      allow read:   if autenticado();
      allow write:  if autenticado()
                    && request.resource.size < 15 * 1024 * 1024
                    && (esPdfOImagen() || esWord());
      allow delete: if autenticado();
    }
  }
}
